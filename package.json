{
  "name": "nsedo-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch-ffmpeg.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "CAPACITOR=1 vite build && rm -rf dist/ffmpeg",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build:android && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/core": "^7.6.11",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.11",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.3",
    "typescript": "5.6",
    "vite": "5.4",
    "vitest": "2.1"
  }
}
